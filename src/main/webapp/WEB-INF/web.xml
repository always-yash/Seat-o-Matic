<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>Seat-o-Matic</display-name>

    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.seatomatic.common.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>auditContextFilter</filter-name>
        <filter-class>com.seatomatic.common.filter.AuditContextFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>auditContextFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>csrfFilter</filter-name>
        <filter-class>com.seatomatic.common.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>csrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>authenticationFilter</filter-name>
        <filter-class>com.seatomatic.common.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>authenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>authorizationFilter</filter-name>
        <filter-class>com.seatomatic.common.filter.AuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>authorizationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>PaperServlet</servlet-name>
        <servlet-class>com.seatomatic.paper.controller.PaperServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaperServlet</servlet-name>
        <url-pattern>/papers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DistributionServlet</servlet-name>
        <servlet-class>com.seatomatic.paper.controller.DistributionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DistributionServlet</servlet-name>
        <url-pattern>/distribution</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InvigilatorServlet</servlet-name>
        <servlet-class>com.seatomatic.paper.controller.InvigilatorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InvigilatorServlet</servlet-name>
        <url-pattern>/invigilator/room</url-pattern>
        <url-pattern>/invigilator</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentServlet</servlet-name>
        <servlet-class>com.seatomatic.student.controller.StudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentServlet</servlet-name>
        <url-pattern>/students</url-pattern>
        <url-pattern>/students/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentImportServlet</servlet-name>
        <servlet-class>com.seatomatic.student.controller.StudentImportServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>15728640</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentImportServlet</servlet-name>
        <url-pattern>/students/import</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- Enable secure cookies at the HTTPS-terminating proxy/container. -->
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>
</web-app>
