<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>Seat-o-Matic</display-name>

    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.seatomatic.common.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>encodingFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter>
        <filter-name>auditContextFilter</filter-name>
        <filter-class>com.seatomatic.common.filter.AuditContextFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>auditContextFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter>
        <filter-name>csrfFilter</filter-name>
        <filter-class>com.seatomatic.common.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>csrfFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.seatomatic.common.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>authFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter>
        <filter-name>authorizationFilter</filter-name>
        <filter-class>com.seatomatic.common.filter.AuthorizationFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>authorizationFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- Enable secure cookies at the HTTPS-terminating proxy/container. -->
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
    <error-page><error-code>403</error-code><location>/WEB-INF/views/error/403.jsp</location></error-page>
    <error-page><error-code>404</error-code><location>/WEB-INF/views/error/404.jsp</location></error-page>
    <error-page><error-code>500</error-code><location>/WEB-INF/views/error/500.jsp</location></error-page>
</web-app>
