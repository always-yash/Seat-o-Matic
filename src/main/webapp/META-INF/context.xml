<Context>
    <Resource name="jdbc/seatomatic"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://localhost:3306/seatomatic?serverTimezone=UTC"
              username="${seatomatic.db.user}"
              password="${seatomatic.db.pass}"
              maxTotal="20"
              maxIdle="5"
              maxWaitMillis="10000"/>
</Context>
