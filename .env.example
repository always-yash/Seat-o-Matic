# Local runtime configuration (keep real secrets in your shell or deployment secret store)
SEAT_ADMIN_USERNAME=operator
SEAT_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional MySQL connection; omit to use the local in-memory H2 database
DATABASE_URL=jdbc:mysql://localhost:3306/seatomatic?serverTimezone=UTC
DATABASE_USERNAME=seatomatic_app
DATABASE_PASSWORD=replace-with-database-password
PAPER_BUFFER_COPIES=2
